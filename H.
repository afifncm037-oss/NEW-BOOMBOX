--========================================================--

local function PlayExecutionSound()
    if EXECUTION_SOUND_ID == ""
        or EXECUTION_SOUND_ID == nil then
        return
    end

    local id =
        tostring(
            EXECUTION_SOUND_ID
        ):match("%d+")

    if not id then
        return
    end

    local StartupSound =
        Instance.new("Sound")

    StartupSound.Name =
        "ROXO_EXECUTION_SOUND"

    StartupSound.SoundId =
        "rbxassetid://" .. id

    StartupSound.Volume = 2
    StartupSound.PlaybackSpeed = 1
    StartupSound.Looped = false
    StartupSound.Parent = SoundService

    pcall(function()
        StartupSound:Play()
    end)

    task.delay(
        12,
        function()
            if StartupSound
                and StartupSound.Parent then

                pcall(function()
                    StartupSound:Destroy()
                end)
            end
        end
    )
end

