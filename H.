local function StartProgressUpdater()
    StopProgressUpdater()

    ProgressConnection =
        RunService.Heartbeat:Connect(
            function()
                if Closing then
                    return
                end

                if not Sound
                    or not Sound.Parent then
                    return
                end

                local current =
                    Sound.TimePosition

                local length =
                    Sound.TimeLength

                if length > 0 then
                    ProgressLabel:Set(
                        FormatTime(current)
                        .. " / "
                        .. FormatTime(length)
                    )
                else
                    ProgressLabel:Set(
                        FormatTime(current)
                        .. " / Loading..."
                    )
                end
            end
        )
end

