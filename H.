local FileAPIAvailable = false

pcall(function()
    FileAPIAvailable =
        type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfile) == "function"
end)

local function SafeJSONEncode(data)
    local success, result = pcall(function()
        return game:GetService("HttpService"):JSONEncode(data)
    end)

    if success then
        return result
    end

    return "[]"
end

local function SafeJSONDecode(data)
    local success, result = pcall(function()
        return game:GetService("HttpService"):JSONDecode(data)
    end)

    if success and type(result) == "table" then
        return result
    end

    return {}
end

local function LoadHistory(filename)
    if not FileAPIAvailable then
        return {}
    end

    local exists = false

    pcall(function()
        exists = isfile(filename)
    end)

    if not exists then
        return {}
    end

    local content

    local success = pcall(function()
        content = readfile(filename)
    end)

    if not success or not content or content == "" then
        return {}
    end

    local decoded = SafeJSONDecode(content)

    if type(decoded) ~= "table" then
        return {}
    end

    return decoded
end

local function SaveHistory(filename, data)
    if not FileAPIAvailable then
        return false
    end

    local encoded = SafeJSONEncode(data)

    return pcall(function()
        writefile(filename, encoded)
    end)
end

local RecentSearches = LoadHistory(HISTORY_SEARCH_FILE)
local RecentMusicIDs = LoadHistory(HISTORY_ID_FILE)

--========================================================--
-- HISTORY SANITIZATION
--========================================================--

local function SanitizeHistory()
    local cleanSearches = {}
    local seenSearches = {}

    for _, item in ipairs(RecentSearches) do
        local value = tostring(item)

        if value ~= ""
            and not seenSearches[value:lower()] then

            seenSearches[value:lower()] = true
            table.insert(cleanSearches, value)

            if #cleanSearches >= MAX_RECENT_SEARCHES then
                break
            end
        end
    end

    RecentSearches = cleanSearches

    local cleanIDs = {}
    local seenIDs = {}

    for _, item in ipairs(RecentMusicIDs) do
        local value = tostring(item)

        if value ~= ""
            and not seenIDs[value] then

            seenIDs[value] = true
            table.insert(cleanIDs, value)

            if #cleanIDs >= MAX_RECENT_IDS then
                break
            end
        end
    end

    RecentMusicIDs = cleanIDs

    SaveHistory(HISTORY_SEARCH_FILE, RecentSearches)
    SaveHistory(HISTORY_ID_FILE, RecentMusicIDs)
end

SanitizeHistory()

--========================================================--
-- HISTORY ADD
--========================================================--

local function AddRecentSearch(keyword)
    keyword = tostring(keyword or "")
    keyword = keyword:gsub("^%s+", ""):gsub("%s+$", "")

    if keyword == "" then
        return
    end

    local lower = keyword:lower()
    local newList = {keyword}

    for _, old in ipairs(RecentSearches) do
        local value = tostring(old)

        if value:lower() ~= lower then
            table.insert(newList, value)
        end

        if #newList >= MAX_RECENT_SEARCHES then
            break
        end
    end

    RecentSearches = newList

    SaveHistory(
        HISTORY_SEARCH_FILE,
        RecentSearches
    )
end

local function AddRecentMusicID(id)
    id = tostring(id or "")

    if id == "" then
        return
    end

    local newList = {id}

    for _, old in ipairs(RecentMusicIDs) do
        local value = tostring(old)

        if value ~= id then
            table.insert(newList, value)
        end

        if #newList >= MAX_RECENT_IDS then
            break
        end
    end

    RecentMusicIDs = newList

    SaveHistory(
        HISTORY_ID_FILE,
        RecentMusicIDs
    )
end

local function ResetRecentSearches()
    RecentSearches = {}

    SaveHistory(
        HISTORY_SEARCH_FILE,
        RecentSearches
    )
end

local function ResetRecentMusicIDs()
    RecentMusicIDs = {}

    SaveHistory(
        HISTORY_ID_FILE,
        RecentMusicIDs
    )
end

--========================================================--
-- HELPERS
--========================================================--

local function Clamp(value, minimum, maximum)
    return math.clamp(
        tonumber(value) or minimum,
        minimum,
        maximum
    )
end

local function FormatTime(seconds)
    seconds = tonumber(seconds) or 0
    seconds = math.max(seconds, 0)

    local minutes = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)

    return string.format(
        "%02d:%02d",
        minutes,
        secs
    )
end

local function SafeString(value, fallback)
    if value == nil then
        return fallback or ""
    end

    local success, result = pcall(function()
        return tostring(value)
    end)

    if not success or result == "" then
        return fallback or ""
    end

    return result
end

local function GetNumber(value)
    return tonumber(value) or 0
end

local function GetAudioID(audio)
    if not audio then
        return nil
    end

    local id

    pcall(function()
        id = audio.Id
    end)

    if id then
        return tostring(id)
    end

    return nil
end

local function GetAudioTitle(audio)
    if not audio then
        return "Unknown Title"
    end

    return SafeString(
        audio.Title,
        "Unknown Title"
    )
end

local function GetAudioArtist(audio)
    if not audio then
        return "Unknown Artist"
    end

    return SafeString(
        audio.Artist,
        "Unknown Artist"
    )
end

local function GetAudioDuration(audio)
    if not audio then
        return 0
    end

    return GetNumber(audio.Duration)
end

local function BuildAudioName(audio)
    return string.format(
        "%s • %s • %s • ID %s",

        GetAudioTitle(audio),

        GetAudioArtist(audio),

        FormatTime(
            GetAudioDuration(audio)
        ),

        tostring(
            GetAudioID(audio)
        )
    )
end

