        MultipleOptions = false,

        Callback = function(option)
            local selected = option[1]

            if not selected then
                SelectedQueueIndex = nil
                return
            end

            local index =
                tonumber(
                    string.match(
                        selected,
                        "^(%d+)%."
                    )
                )

            SelectedQueueIndex = index
        end
    })

